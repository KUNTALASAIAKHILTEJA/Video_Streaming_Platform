# Django Core Settings
SECRET_KEY=your-secure-random-secret-key
DEBUG=False
ALLOWED_HOSTS=video-streaming-backend.onrender.com,localhost,127.0.0.1

# Turso Cloud Database Credentials (9 GB Free Storage)
# Get your URL and Auth Token from https://turso.tech
TURSO_DB_URL=libsql://video-streaming-db-username.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# Cloudflare R2 Media Storage Credentials (10 GB Free Storage, Zero Egress Fees)
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=video-streaming-media
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# CORS Settings (Allow React Frontend)
CORS_ALLOWED_ORIGINS=https://your-app.pages.dev,http://localhost:5173
