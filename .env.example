SECRET_KEY=change-this-local-development-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=

# Media storage: set to use Cloudinary instead of the local media/ folder
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Production: set DATABASE_URL instead of the DB_* values below
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Local PostgreSQL
DB_NAME=video_streaming
DB_USER=postgres
DB_PASSWORD=change-this-postgresql-password
DB_HOST=127.0.0.1
DB_PORT=5432
